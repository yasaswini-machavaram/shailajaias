# Server Configuration
PORT=4000
NODE_ENV=production

# Frontend Origin for CORS (e.g., https://shailajaias.com)
CLIENT_URL=https://shailajaias.com

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/shailaja-ias?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/shailaja-ias?retryWrites=true&w=majority

# JWT Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=your-production-jwt-secret-at-least-32-chars

# AWS S3 & CloudFront Configuration (Mumbai: ap-south-1)
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=shailaja-ias-prod-media
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Optional CloudFront CDN domain (e.g., https://cdn.shailajaias.com)
CDN_URL=

# OTPless (WhatsApp Login) Production Credentials
OTPLESS_CLIENT_ID=your-otpless-client-id
OTPLESS_CLIENT_SECRET=your-otpless-client-secret
